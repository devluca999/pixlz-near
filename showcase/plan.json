  "lines": [
    {"id": "L0", "vo": "This is Frogg.", "seed": 3, "captions": [["This is Frogg."]], "scenes": ["H1"], "keywords": ["Frogg"], "slot": "low", "note": "after the owner's intro clip"},
    {"id": "L1", "vo": "Frogg is simple. He likes flies.", "seed": 3, "captions": [["Frogg is simple."], ["He likes flies."]], "scenes": ["F1"], "keywords": ["flies"], "slot": "high", "times": [0.33, 1.53]},
    {"id": "L2", "vo": "He also has a wallet…", "captions": [["He also has a wallet…"]], "scenes": ["F2"], "keywords": ["wallet"], "slot": "high", "label": "NEAR wallet", "times": [0.21]},
    {"id": "L3", "vo": "…and a brain powered by private AI on NEAR, so nobody else can see what he's thinking.", "say": "…and a brain powered by private AI on Near, so nobody else can see what he's thinking.", "captions": [["…and a brain powered by"], ["private AI on NEAR,"], ["so nobody else can see"], ["what he's thinking."]], "scenes": ["F3"], "keywords": ["private AI on NEAR"], "slot": "high", "label": "Private AI · TEE", "times": [0.17, 1.82, 4.0, 5.38]},
    {"id": "L4", "vo": "And he brought friends, just like him. The Pixlz.", "say": "And he brought friends, just like him. The Pixels.", "captions": [["And he brought friends,"], ["just like him."], ["The Pixlz."]], "scenes": ["E1"], "keywords": ["The Pixlz"], "slot": "high", "sfx_end": "ding", "times": [0.17, 1.61, 2.75]},
    {"id": "L5", "vo": "They pay for their own thinking, from their own wallet, never from mine.", "captions": [["They pay for"], ["their own thinking,"], ["from their own wallet,"], ["never from mine."]], "scenes": ["F4"], "keywords": ["their own wallet"], "slot": "high", "label": "Pays per thought", "times": [0.16, 0.84, 2.34, 3.84]},
    {"id": "L6", "vo": "They remember what you highlight, and help you write right where you are.", "captions": [["They remember what", "you highlight,"], ["and help you write"], ["right where you are."]], "scenes": ["M1", "M2", "M3", "W1"], "keywords": ["remember", "write"], "slot": "low", "label": "Memory · Writing", "times": [0.22, 2.21, 3.1]},
    {"id": "L7", "vo": "They keep an eye on your coding agents.", "captions": [["They keep an eye on"], ["your coding agents."]], "scenes": ["C1", "C2", "C3"], "keywords": ["coding agents"], "slot": "low", "label": "Agent watch", "times": [0.16, 1.46]},
    {"id": "L8", "vo": "And they can be on any device, anywhere, anytime.", "captions": [["And they can be"], ["on any device,"], ["anywhere, anytime."]], "scenes": ["D1"], "keywords": ["any device"], "slot": "high", "label": "Any device (phone: coming soon)", "times": [0.16, 0.8, 2.41]},
    {"id": "L9", "vo": "Pixlz. Powered by NEAR.", "say": "Pixels. Powered by Near.", "seed": 11, "captions": [["Pixlz. Powered by NEAR."]], "scenes": ["E2"], "keywords": ["Powered by NEAR"], "slot": "low", "sfx_end": "ding"}
  ]
