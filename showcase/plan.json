{
  "title": "Pixlz · powered by NEAR",
  "intro_gap_seconds": 4.5,
  "voice": {"reference": "voice-deep.wav", "exaggeration": 0.45, "cfg_weight": 0.5, "tempo": 1.25},
  "lines": [
    {"id": "L0", "vo": "This is Frogg.", "seed": 3, "captions": [["This is Frogg."]], "scenes": ["H1"], "keywords": ["Frogg"], "slot": "low", "note": "after the owner's intro clip"},
    {"id": "L1", "vo": "Frogg is simple. He likes flies.", "seed": 3, "captions": [["Frogg is simple."], ["He likes flies."]], "scenes": ["F1"], "keywords": ["flies"], "slot": "high", "times": [0.14, 1.29]},
    {"id": "L2", "tempo": 1.15, "vo": "He also has a wallet…", "captions": [["He also has a wallet…"]], "scenes": ["F2"], "keywords": ["wallet"], "slot": "high", "label": "NEAR wallet", "times": [0.17]},
    {"id": "L3", "vo": "…and a brain powered by private AI on NEAR, so nobody else can see what he's thinking.", "say": "…and a brain powered by private AI on Near, so nobody else can see what he's thinking.", "captions": [["…and a brain powered by"], ["private AI on NEAR,"], ["so nobody else can see"], ["what he's thinking."]], "scenes": ["F3"], "keywords": ["private AI on NEAR"], "slot": "high", "label": "Private AI · TEE", "times": [0.12, 1.63, 3.55, 5.02]},
    {"id": "L4", "vo": "And he brought friends, just like him. The Pixlz.", "say": "And he brought friends, just like him. The Pixels.", "captions": [["And he brought friends,"], ["just like him."], ["The Pixlz."]], "scenes": ["E1"], "keywords": ["The Pixlz"], "slot": "high", "sfx_end": "ding", "times": [0.15, 1.76, 3.02]},
    {"id": "L5", "vo": "They pay for their own thinking, from their own wallet, never from mine.", "captions": [["They pay for", "their own thinking,"], ["from their own wallet,"], ["never from mine."]], "scenes": ["F4"], "keywords": ["their own wallet"], "slot": "high", "label": "Pays per thought", "times": [0.15, 2.24, 3.49]},
    {"id": "L6", "vo": "They remember what you highlight, and always take you back to the source.", "captions": [["They remember what", "you highlight,"], ["and always take you"], ["back to the source."]], "scenes": ["M1", "M2", "M3"], "keywords": ["remember", "source"], "slot": "low", "label": "Memory", "times": [0.16, 1.88, 2.7]},
    {"id": "L6b", "tempo": 1.05, "vo": "They help you write right where you are.", "captions": [["They help you write"], ["right where you are."]], "scenes": ["W1"], "keywords": ["write"], "slot": "low", "label": "Writing", "times": [0.22, 0.92]},
    {"id": "L7", "tempo": 1.15, "vo": "They keep an eye on your coding agents.", "captions": [["They keep an eye on"], ["your coding agents."]], "scenes": ["C1", "C2", "C3"], "keywords": ["coding agents"], "slot": "low", "label": "Agent watch", "times": [0.18, 1.28]},
    {"id": "L8", "vo": "And they can be on any device, anywhere, anytime.", "captions": [["And they can be", "on any device,"], ["anywhere, anytime."]], "scenes": ["D1"], "keywords": ["any device"], "slot": "high", "label": "Any device (phone: coming soon)", "times": [0.18, 1.93]},
    {"id": "L9", "vo": "Pixlz. Powered by NEAR.", "say": "Pixels. Powered by Near.", "seed": 21, "captions": [["Pixlz. Powered by NEAR."]], "scenes": ["E2"], "keywords": ["Powered by NEAR"], "slot": "low", "sfx_end": "ding"}
  ]
}
