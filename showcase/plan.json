{
  "title": "Pixlz · powered by NEAR",
  "intro_gap_seconds": 4.5,
  "voice": {"reference": "voice-mid.wav", "exaggeration": 0.45, "cfg_weight": 0.5, "tempo": 1.25},
  "lines": [
    {"id": "L0", "vo": "This is Frogg.", "seed": 3, "captions": [["This is Frogg."]], "scenes": ["H1"], "keywords": ["Frogg"], "slot": "low", "note": "after the owner's intro clip"},
    {"id": "L1", "vo": "Frogg is simple. He likes flies.", "seed": 3, "captions": [["Frogg is simple."], ["He likes flies."]], "scenes": ["F1"], "keywords": ["flies"], "slot": "high", "times": [0.14, 1.14]},
    {"id": "L2", "tempo": 1.2, "vo": "He also has a wallet…", "seed": 3, "captions": [["He also has a wallet…"]], "scenes": ["F2"], "keywords": ["wallet"], "slot": "high", "label": "NEAR wallet", "times": [0.25]},
    {"id": "L3", "vo": "…and a brain powered by private AI on NEAR, so nobody else can see what he's thinking.", "say": "…and a brain powered by private AI on Near, so nobody else can see what he's thinking.", "captions": [["…and a brain powered by"], ["private AI on NEAR,"], ["so nobody else can see"], ["what he's thinking."]], "scenes": ["F3"], "keywords": ["private AI on NEAR"], "slot": "high", "label": "Private AI · TEE", "times": [0.12, 1.61, 3.3, 4.5]},
    {"id": "L4", "tempo": 1.35, "vo": "And he brought friends, just like him. The Pixlz.", "say": "And he brought friends, just like him. The Pixels.", "captions": [["And he brought friends,"], ["just like him."], ["The Pixlz."]], "scenes": ["E1"], "keywords": ["The Pixlz"], "slot": "high", "sfx_end": "ding", "times": [0.01, 1.02, 2.56]},
    {"id": "L5", "tempo": 1.05, "vo": "They pay for their own thinking, from their own wallet, never from mine.", "captions": [["They pay for", "their own thinking,"], ["from their own wallet,"], ["never from mine."]], "scenes": ["F4"], "keywords": ["their own wallet"], "slot": "high", "label": "Pays per thought", "times": [0.21, 2.12, 3.28]},
    {"id": "L6", "vo": "They remember what you highlight, and always take you back to the source.", "captions": [["They remember what", "you highlight,"], ["and always take you"], ["back to the source."]], "scenes": ["M1", "M2", "M3"], "keywords": ["remember", "source"], "slot": "low", "label": "Memory", "times": [0.18, 2.13, 3.14]},
    {"id": "L6b", "tempo": 0.92, "vo": "They help you write right where you are.", "seed": 31, "captions": [["They help you write"], ["right where you are."]], "scenes": ["W1"], "keywords": ["write"], "slot": "low", "label": "Writing", "times": [0.29, 1.51]},
    {"id": "L7", "tempo": 1.0, "vo": "They keep an eye on your coding agents.", "captions": [["They keep an eye on"], ["your coding agents."]], "scenes": ["C1", "C2", "C3"], "keywords": ["coding agents"], "slot": "low", "label": "Agent watch", "times": [0.25, 1.44]},
    {"id": "L8", "tempo": 1.15, "vo": "And they can hop to your other devices.", "seed": 21, "captions": [["And they can hop"], ["to your other devices."]], "scenes": ["D1"], "keywords": ["other devices"], "slot": "high", "label": "Any device (phone: coming soon)", "times": [0.2, 1.56]},
    {"id": "L9", "tempo": 1.1, "vo": "Pixlz. Powered by NEAR.", "say": "Pixels. Powered by Near.", "seed": 7, "captions": [["Pixlz. Powered by NEAR."]], "scenes": ["E2"], "keywords": ["Powered by NEAR"], "slot": "low", "sfx_end": "ding"}
  ]
