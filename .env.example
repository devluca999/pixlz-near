# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- secrets (leave empty here) ---
# NEAR AI Cloud API key (cloud.near.ai → API Keys, or the NearBuilders key). Needed for polish; attestation works without it.
NEAR_AI_API_KEY=
# NEAR Intents agent API key. Unused: Frogg's wallet is a funded NEAR sub-account (see README).
AGENT_CONNECT_API_KEY=

# --- Frogg's wallet (public account names, not secrets) ---
# Testnet only. Your account is the parent; it signs (in Meteor) only to create and fund Frogg.
NEAR_NETWORK=testnet
FROGG_PARENT_ACCOUNT=sylversurferr.testnet
FROGG_ACCOUNT=frogg.sylversurferr.testnet
# Who Frogg pays for its inference (default: the parent, who holds the NEAR AI credits).
FROGG_PAYEE=sylversurferr.testnet
# Caps, in testnet NEAR. Frogg's balance is the hard cap; these stop it spending it all at once.
FROGG_MAX_PER_REQUEST_NEAR=0.01
FROGG_MAX_PER_DAY_NEAR=0.1
FROGG_RESERVE_NEAR=0.05
# Pricing: NEAR AI's per-request USD cost × this rate; flat price when the cost isn't reported yet.
PIXL_NEAR_PER_USD=0.4
FROGG_FLAT_PRICE_NEAR=0.0005
NEAR_RPC_URL=https://rpc.testnet.near.org
