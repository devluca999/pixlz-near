# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- secrets (leave empty here) ---
# NEAR AI Cloud API key (cloud.near.ai → API Keys, or the NearBuilders key). Needed for polish; attestation works without it.
NEAR_AI_API_KEY=
# NEAR Intents agent API key. Unused: Frogg's wallet is a funded NEAR sub-account (see README).
AGENT_CONNECT_API_KEY=

# --- Frogg's wallet (public account names, not secrets) ---
# Testnet only. Your account is the parent; it signs (in Meteor) only to create and fund Frogg.
NEAR_NETWORK=testnet
FROGG_PARENT_ACCOUNT=sylversurferr.testnet
FROGG_ACCOUNT=frogg.sylversurferr.testnet
