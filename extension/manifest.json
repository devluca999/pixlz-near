{
  "manifest_version": 3,
  "name": "Pixl Memory",
  "version": "0.2.0",
  "description": "Save highlights to Pixl Memory on your Mac (with a link back to the passage), and let Frogg polish text in web pages.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pixl Memory",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the selection to Pixl Memory"
    }
  },
  "key": ""
}
