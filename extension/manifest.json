{
  "manifest_version": 3,
  "name": "Pixl Memory",
  "version": "0.1.0",
  "description": "Save highlights to Pixl Memory on your Mac, with a link that reopens the page at that passage.",
  "minimum_chrome_version": "120",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Pixl Memory", "default_popup": "popup.html" },
  "options_page": "options.html",
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the selection to Pixl Memory"
    }
  }
}
